<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.gestorclientesfx.controller.ClienteController"
            prefWidth="920" prefHeight="560" stylesheets="@estilo-oscuro.css" styleClass="raiz">

    <!-- Encabezado -->
    <top>
        <VBox styleClass="encabezado">
            <Label text="Gestor de Clientes" styleClass="titulo"/>
            <Label text="JavaFX + MySQL · capa DAO" styleClass="subtitulo"/>
        </VBox>
    </top>

    <!-- Tabla de clientes (Paso 4) -->
    <center>
        <TableView fx:id="tablaClientes" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" styleClass="col-id"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="210"/>
                <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay clientes para mostrar."/>
            </placeholder>
            <BorderPane.margin>
                <Insets top="0" right="10" bottom="0" left="20"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <!-- Formulario lateral -->
    <right>
        <VBox styleClass="panel-formulario" spacing="14" prefWidth="290">
            <BorderPane.margin>
                <Insets top="0" right="20" bottom="0" left="10"/>
            </BorderPane.margin>
            <Label text="Datos del cliente" styleClass="titulo-panel"/>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="60"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="ID" GridPane.rowIndex="0"/>
                <TextField fx:id="txtId" editable="false" promptText="automático" styleClass="campo-id"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Nombre" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Correo" GridPane.rowIndex="2"/>
                <TextField fx:id="txtCorreo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Ciudad" GridPane.rowIndex="3"/>
                <TextField fx:id="txtCiudad" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Guardar" onAction="#guardarCliente" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizarCliente"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="10">
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarCliente" styleClass="boton-peligro"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Limpiar" onAction="#limpiarFormulario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Seleccione una fila de la tabla para editarla o eliminarla."
                   wrapText="true" styleClass="ayuda"/>
        </VBox>
    </right>

    <!-- Barra de estado -->
    <bottom>
        <HBox styleClass="barra-estado">
            <Label fx:id="lblEstado" text=" "/>
        </HBox>
    </bottom>
</BorderPane>
